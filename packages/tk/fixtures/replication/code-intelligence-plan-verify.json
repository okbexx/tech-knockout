{
  "id": "code-intelligence-plan-verify",
  "capability": "local code intelligence MCP",
  "from": "codegraph",
  "limit": 5,
  "sourceBacked": ["codegraph"],
  "expect": {
    "referenceIds": [
      "codegraph"
    ],
    "verificationContract": "local-code-intelligence-mcp:v1",
    "verifyStatus": "warn",
    "checkStatuses": {
      "plan_schema_valid": "pass",
      "reference_projects_present": "pass",
      "kernel_present": "pass",
      "verification_contract_present": "pass",
      "source_backing": "pass",
      "target_project_implementation": "warn"
    },
    "warningIncludes": ["Target-project implementation was not inspected"],
    "minCounts": {
      "kernel": 1,
      "mustKeep": 2,
      "canAdapt": 2,
      "risks": 1
    },
    "traceSteps": [
      "resolve_references",
      "build_plan",
      "verify"
    ],
    "traceArtifactsByStep": {
      "resolve_references": [
        "references.json"
      ],
      "build_plan": [
        "plan.json",
        "brief.md"
      ],
      "verify": [
        "verification.json"
      ]
    },
    "artifactFiles": [
      "brief.md",
      "input.json",
      "plan.json",
      "references.json",
      "trace.json",
      "verification.json"
    ]
  }
}
